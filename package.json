{
  "name": "cosmic-eye",
  "version": "0.5.5",
  "description": "RUM metrics toolkit for SPAs: duplicate request detection and route transition timing",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/react.js",
    "dist/react.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:rdr": "vitest run tests/rdr",
    "test:rt": "vitest run tests/rt",
    "test:extensions": "vitest run tests/extensions --passWithNoTests",
    "test:watch": "vitest",
    "test:watch:rdr": "vitest tests/rdr",
    "test:watch:rt": "vitest tests/rt",
    "test:watch:extensions": "vitest tests/extensions --passWithNoTests",
    "lint": "eslint src/ tests/",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run lint && npm run typecheck && npm run build"
  },
  "keywords": [
    "rum",
    "duplicate-requests",
    "monitoring",
    "spa",
    "metrics"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayonez1/CosmicEye.git"
  },
  "homepage": "https://github.com/jayonez1/CosmicEye#readme",
  "bugs": {
    "url": "https://github.com/jayonez1/CosmicEye/issues"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "react-router-dom": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "14.0.0",
    "@types/node": "20.11.0",
    "@types/react": "18.0.0",
    "@types/react-dom": "18.0.0",
    "@typescript-eslint/eslint-plugin": "7.0.0",
    "@typescript-eslint/parser": "7.0.0",
    "eslint": "8.57.0",
    "jsdom": "24.0.0",
    "prettier": "3.2.0",
    "react": "18.0.0",
    "react-dom": "18.0.0",
    "react-router-dom": "6.0.0",
    "tsup": "8.0.0",
    "typescript": "5.4.0",
    "vitest": "1.4.0"
  }
}
